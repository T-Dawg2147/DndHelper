<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DndHelper.App.ViewModels.Panels"
             x:Class="DndHelper.App.View.Panels.BattleLogPanelView"
             x:DataType="vm:BattleLogPanelViewModel">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
        <TextBlock Text="Battle Log" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Text="Rolls, damage and effects will be logged here (M5)." Opacity="0.7" HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>
