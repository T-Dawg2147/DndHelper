<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DndHelper.App.ViewModels.Panels"
             x:Class="DndHelper.App.View.Panels.BattleLogPanelView"
             x:DataType="vm:BattleLogPanelViewModel">

  <Grid RowDefinitions="Auto,*" Margin="8">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
      <Button Content="Clear log" Command="{Binding ClearCommand}" />
      <Button Content="Export log..." Command="{Binding ExportCommand}" />
    </StackPanel>
    <ListBox Grid.Row="1" ItemsSource="{Binding Lines}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="x:String">
          <TextBlock Text="{Binding}" TextWrapping="Wrap" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>

</UserControl>
