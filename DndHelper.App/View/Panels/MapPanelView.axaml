<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DndHelper.App.ViewModels.Panels"
             x:Class="DndHelper.App.View.Panels.MapPanelView"
             x:DataType="vm:MapPanelViewModel">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
        <TextBlock Text="Map" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Text="Hex map will live here (M4)." Opacity="0.7" HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>
